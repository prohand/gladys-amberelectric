{
  "manifest_version": 1,
  "type": "device",
  "name": "Amber Electric",
  "description": {
    "en": "Live and forecast Amber Electric prices, price spikes and renewables, for your scenes.",
    "fr": "Prix Amber Electric en direct et prévus, pics de prix et renouvelables, pour vos scènes.",
    "de": "Aktuelle und prognostizierte Amber-Electric-Preise, Preisspitzen und Erneuerbare.",
    "es": "Precios de Amber Electric en directo y previstos, picos de precio y renovables."
  },
  "version": "1.2.0",
  "docker_image": "ghcr.io/prohand/gladys-amberelectric:1.2.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/prohand/gladys-amberelectric/main/cover.png",
  "categories": ["energy"],
  "keywords": [
    "aemo",
    "nem",
    "australia",
    "wholesale",
    "spot price",
    "dynamic pricing",
    "feed-in tariff",
    "solar export",
    "controlled load"
  ],
  "countries": ["AU"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer",
        "de": "Erste Schritte",
        "es": "Primeros pasos"
      },
      "description": {
        "en": "This integration reads your Amber Electric prices from the Amber cloud. Create a personal API token in the Amber web app (Developers page, Generate a new token), paste it below and save: your sites show up in the Discovery tab.",
        "fr": "Cette intégration lit vos prix Amber Electric depuis le cloud Amber. Créez un jeton d'API personnel dans l'application web Amber (page Developers, Generate a new token), collez-le ci-dessous et enregistrez : vos sites apparaissent dans l'onglet Découverte.",
        "de": "Diese Integration liest deine Amber-Electric-Preise aus der Amber-Cloud. Erstelle in der Amber-Web-App ein persönliches API-Token (Seite Developers, Generate a new token), füge es unten ein und speichere: Deine Standorte erscheinen im Tab Erkennung.",
        "es": "Esta integración lee sus precios de Amber Electric desde la nube de Amber. Cree un token de API personal en la aplicación web de Amber (página Developers, Generate a new token), péguelo abajo y guarde: sus sitios aparecen en la pestaña Descubrimiento."
      },
      "links": [
        {
          "url": "https://app.amber.com.au/developers/",
          "label": {
            "en": "Amber API token",
            "fr": "Jeton d'API Amber",
            "de": "Amber-API-Token",
            "es": "Token de API de Amber"
          }
        },
        {
          "url": "https://github.com/prohand/gladys-amberelectric/blob/main/docs/en.md",
          "label": {
            "en": "Integration documentation",
            "fr": "Documentation de l'intégration",
            "de": "Dokumentation der Integration",
            "es": "Documentación de la integración"
          }
        }
      ]
    },
    {
      "key": "api_token",
      "type": "secret",
      "label": {
        "en": "Amber API token",
        "fr": "Jeton d'API Amber",
        "de": "Amber-API-Token",
        "es": "Token de API de Amber"
      },
      "description": {
        "en": "The personal token created on app.amber.com.au/developers. It only reads your sites and prices.",
        "fr": "Le jeton personnel créé sur app.amber.com.au/developers. Il ne fait que lire vos sites et vos prix.",
        "de": "Das persönliche Token, erstellt auf app.amber.com.au/developers. Es liest nur deine Standorte und Preise.",
        "es": "El token personal creado en app.amber.com.au/developers. Solo lee sus sitios y sus precios."
      },
      "required": true
    },
    {
      "key": "site_id",
      "type": "string",
      "label": {
        "en": "Site",
        "fr": "Site",
        "de": "Standort",
        "es": "Sitio"
      },
      "description": {
        "en": "Leave empty to follow every active site of the account. To follow only one, its Amber id or its NMI: \"Test the connection\" lists them.",
        "fr": "Laissez vide pour suivre tous les sites actifs du compte. Pour n'en suivre qu'un, son identifiant Amber ou son NMI : « Tester la connexion » les liste.",
        "de": "Leer lassen, um alle aktiven Standorte des Kontos zu verfolgen. Um nur einen zu verfolgen, seine Amber-ID oder seine NMI: „Verbindung testen“ listet sie auf.",
        "es": "Déjelo vacío para seguir todos los sitios activos de la cuenta. Para seguir solo uno, su identificador de Amber o su NMI: «Probar la conexión» los lista."
      },
      "placeholder": {
        "en": "empty = every active site",
        "fr": "vide = tous les sites actifs",
        "de": "leer = alle aktiven Standorte",
        "es": "vacío = todos los sitios activos"
      },
      "required": false
    },
    {
      "key": "poll_frequency",
      "type": "number",
      "label": {
        "en": "Refresh interval (s)",
        "fr": "Intervalle de rafraîchissement (s)",
        "de": "Aktualisierungsintervall (s)",
        "es": "Intervalo de actualización (s)"
      },
      "description": {
        "en": "How often the prices are read, in seconds. Amber publishes a new price every 5 minutes (300 s) and limits the number of calls: one minute at least.",
        "fr": "Fréquence de lecture des prix, en secondes. Amber publie un nouveau prix toutes les 5 minutes (300 s) et limite le nombre d'appels : une minute au minimum.",
        "de": "Wie oft die Preise gelesen werden, in Sekunden. Amber veröffentlicht alle 5 Minuten (300 s) einen neuen Preis und begrenzt die Anzahl der Abfragen: mindestens eine Minute.",
        "es": "Frecuencia de lectura de los precios, en segundos. Amber publica un nuevo precio cada 5 minutos (300 s) y limita el número de llamadas: un minuto como mínimo."
      },
      "required": false,
      "default": 300,
      "min": 60,
      "max": 3600
    },
    {
      "key": "forecast_hours",
      "type": "number",
      "label": {
        "en": "Forecast horizon (h)",
        "fr": "Horizon des prévisions (h)",
        "de": "Prognosehorizont (h)",
        "es": "Horizonte de previsión (h)"
      },
      "description": {
        "en": "How many hours of forecast prices are read, for the dashboard chart and the cheapest window.",
        "fr": "Nombre d'heures de prix prévus à lire, pour le graphique du tableau de bord et le créneau le moins cher.",
        "de": "Wie viele Stunden prognostizierter Preise gelesen werden, für das Dashboard-Diagramm und das günstigste Zeitfenster.",
        "es": "Cuántas horas de precios previstos se leen, para el gráfico del panel y la franja más barata."
      },
      "required": false,
      "default": 12,
      "min": 1,
      "max": 48
    },
    {
      "key": "debug_logs",
      "type": "boolean",
      "label": {
        "en": "Detailed logs (debug)",
        "fr": "Journaux détaillés (debug)",
        "de": "Detaillierte Protokolle (Debug)",
        "es": "Registros detallados (depuración)"
      },
      "description": {
        "en": "Log every call to Amber and every price read. The API token is never logged.",
        "fr": "Journalise chaque appel à Amber et chaque prix lu. Le jeton d'API n'est jamais journalisé.",
        "de": "Protokolliert jede Abfrage bei Amber und jeden gelesenen Preis. Das API-Token wird nie protokolliert.",
        "es": "Registra cada llamada a Amber y cada precio leído. El token de API nunca se registra."
      },
      "required": false,
      "default": false
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 30
    }
  ],
  "widgets": [
    {
      "key": "amber_prices",
      "label": {
        "en": "Amber prices",
        "fr": "Prix Amber",
        "de": "Amber-Preise",
        "es": "Precios de Amber"
      },
      "description": {
        "en": "Price now, feed-in, renewables, price level, spikes and the forecast.",
        "fr": "Prix actuel, injection, renouvelables, niveau de prix, pics et prévisions.",
        "de": "Aktueller Preis, Einspeisung, Erneuerbare, Preisniveau, Spitzen und Prognose.",
        "es": "Precio actual, inyección, renovables, nivel de precio, picos y previsión."
      },
      "icon": "zap",
      "settings": [
        {
          "key": "site",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Site",
            "fr": "Site",
            "de": "Standort",
            "es": "Sitio"
          },
          "description": {
            "en": "Leave empty for the first site.",
            "fr": "Laissez vide pour le premier site.",
            "de": "Leer lassen für den ersten Standort.",
            "es": "Déjelo vacío para el primer sitio."
          },
          "required": false
        }
      ],
      "action_timeout_seconds": 30
    }
  ],
